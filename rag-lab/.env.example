# Copy this file to .env and fill in the keys you actually use.
# .env is gitignored — secrets live here ONLY, never in YAML.
# You only need ONE LLM provider key to get started.

# ─────────────────────────────────────────────────────────
# LLM PROVIDERS — pick one (or switch between them via config)
# ─────────────────────────────────────────────────────────

# 1. Anthropic (Claude)
#    Get your key: https://console.anthropic.com/
#    NOTE: Your claude.ai Pro *subscription* does NOT include API access.
#    API access is separate and billed per token at console.anthropic.com.
#    Free tier gives $5 credit to try it; after that it's pay-per-token.
ANTHROPIC_API_KEY=

# 2. OpenRouter (access 100+ models, many with free tiers)
#    Get your key: https://openrouter.ai/keys
#    Free models are marked ":free" — no credit card needed for those.
#    See all free models: https://openrouter.ai/models?q=free
OPENROUTER_API_KEY=

# 3. Groq (ultra-fast inference, generous free tier)
#    Get your key: https://console.groq.com/
#    Free tier: 14,400 requests/day on Llama 3.1, Mixtral, Gemma, etc.
GROQ_API_KEY=

# 4. Ollama (fully local, no key or cost)
#    Install: https://ollama.com/  then `ollama pull llama3.2`
#    Leave the key blank; set the base URL if not on localhost.
OLLAMA_BASE_URL=http://localhost:11434

# ─────────────────────────────────────────────────────────
# EMBEDDINGS — pick one
# ─────────────────────────────────────────────────────────

# sentence-transformers: runs locally, no key, no cost (recommended default).
# Nothing to set — it just works when profile = local_st.

# OpenAI embeddings (best quality, costs ~$0.00002/1K tokens)
OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────
# VECTOR STORES — set only what you use
# ─────────────────────────────────────────────────────────

# Chroma: local on-disk, no config needed.

# Qdrant: run locally via docker-compose or point to Qdrant Cloud.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ─────────────────────────────────────────────────────────
# GRAPH STORE (Graph-Augmented RAG only)
# ─────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ─────────────────────────────────────────────────────────
# OPTIONAL OBSERVABILITY
# ─────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ─────────────────────────────────────────────────────────
# APP OVERRIDES  (RAGLAB_ prefix overrides any YAML value)
# ─────────────────────────────────────────────────────────
# RAGLAB_LLM__PROFILE=openrouter_free
# RAGLAB_EMBEDDINGS__PROFILE=local_st
# RAGLAB_VECTORDB__PROFILE=chroma
RAGLAB_LOG_LEVEL=INFO
